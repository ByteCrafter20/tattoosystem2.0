<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory - Tattoo Home-Based Management System</title>

    <link rel="stylesheet" href="/css/inventory.css">

    <style>
        /* ===== BACKGROUND IMAGE WITH BLUR ===== */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('/images/TotatsSkinArtTattoo.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            opacity: 0.15;
            filter: blur(8px);
            -webkit-filter: blur(8px);
            z-index: -1;
            pointer-events: none;
        }

        /* Navbar stays on top (sticky) so the hamburger button is never covered */
        .navbar {
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .container {
            position: relative;
            z-index: 1;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(2px);
            border-radius: 10px;
            margin: 20px auto;
            max-width: 1400px;
            padding: 40px;
        }

        .inventory-card { background: rgba(255, 255, 255, 0.95); }
        .summary-card { background: rgba(255, 255, 255, 0.95); }
        .modal-content { background: rgba(255, 255, 255, 0.98); }

        /* Small helper text under the form inputs */
        .field-hint {
            display: block;
            margin-top: 4px;
            font-size: 12px;
            color: #666;
            line-height: 1.3;
        }

        /* Small explanation under the table column titles */
        th .th-sub {
            display: block;
            font-size: 11px;
            font-weight: normal;
            opacity: 0.75;
        }
    </style>

</head>

<body>

    <nav class="navbar">

        <div class="logo">
            <img src="/images/TotatsSkinArtTattoo.jpg" alt="Totats Skin Art Tattoo Logo">
            Totats<span>Skin Art Tattoo</span>
        </div>

        <ul class="nav-links">
            <li><a href="/dashboard">Dashboard</a></li>
            <li><a href="/clientappointment">Appointment of a Client</a></li>
            <li><a href="/inventory" class="active">Inventory</a></li>
            <li><a href="/reports">Reports &amp; Records</a></li>
            <li><a href="/photos">Photos Gallery</a></li>
        </ul>

        <button id="hamburgerBtn" class="hamburger" type="button"
                aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileMenu">
            <span></span><span></span><span></span>
        </button>

    </nav>

    <!-- Mobile menu (outside the navbar, right after it) -->
    <div id="mobileMenu" class="mobile-menu">
        <ul>
            <li><a href="/dashboard">Dashboard</a></li>
            <li><a href="/clientappointment">Appointment of a Client</a></li>
            <li><a href="/inventory" class="active">Inventory</a></li>
            <li><a href="/reports">Reports &amp; Records</a></li>
            <li><a href="/photos">Photos Gallery</a></li>
            <li><a href="/logout">Logout</a></li>
        </ul>
    </div>


    <main class="container">

        <div class="page-header">
            <div>
                <h1>Inventory Management</h1>
            </div>

            <button class="add-btn" id="openInventoryModalBtn">
                + Add Inventory
            </button>
        </div>


        <section class="inventory-summary">

            <div class="summary-card">
                <div>
                    <p>Total Items</p>
                    <h2 id="totalItems">0</h2>
                </div>
            </div>

            <div class="summary-card">
                <div>
                    <p>In Stock</p>
                    <h2 id="availableItems">0</h2>
                </div>
            </div>

            <div class="summary-card warning-card">
                <div>
                    <p>Low Stock</p>
                    <h2 id="lowStockItems">0</h2>
                </div>
            </div>

            <div class="summary-card danger-card">
                <div>
                    <p>Out of Stock</p>
                    <h2 id="outOfStockItems">0</h2>
                </div>
            </div>

        </section>


        <section class="inventory-controls">

            <input type="text" id="searchInventory" placeholder="Search inventory...">

            <select id="categoryFilter">
                <option value="all">All Categories</option>
                <option value="Ink">Ink</option>
                <option value="Needles">Needles</option>
                <option value="Machines">Machines</option>
                <option value="Accessories">Accessories</option>
                <option value="Sanitation">Sanitation</option>
                <option value="Other">Other</option>
            </select>

            <select id="stockFilter">
                <option value="all">All Stock Status</option>
                <option value="In Stock">In Stock</option>
                <option value="Low Stock">Low Stock</option>
                <option value="Out of Stock">Out of Stock</option>
            </select>

            <button class="refresh-btn" id="refreshInventoryBtn">Refresh</button>

        </section>


        <section class="inventory-card">

            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Category</th>
                            <th>Quantity</th>
                            <th>Low Stock</th>
                            <th>Status</th>
                            <th>Stock</th>
                        </tr>
                    </thead>

                    <!-- Rows come from MongoDB via /api/inventory -->
                    <tbody id="inventoryTable">
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 40px; color: #666;">
                                Loading inventory...
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </section>

    </main>


    <!-- Add Modal -->
    <div id="inventoryModal" class="modal">

        <div class="modal-content">

            <div class="modal-header">
                <div>
                    <h2>Add Inventory</h2>
                    <p>Add a new tattoo supply or equipment.</p>
                </div>

                <button class="close-btn" id="closeInventoryModalBtn">&times;</button>
            </div>


            <form id="inventoryForm">

                <div class="form-group">
                    <label for="itemCategory">Category</label>

                    <select id="itemCategory" required>
                        <option value="">Select Category</option>
                        <option value="Ink">Ink</option>
                        <option value="Needles">Needles</option>
                        <option value="Machines">Machines</option>
                        <option value="Accessories">Accessories</option>
                        <option value="Sanitation">Sanitation</option>
                        <option value="Other">Other</option>
                    </select>
                </div>


                <div class="form-group">
                    <label for="itemName">Item Name</label>

                    <!-- Options are filled by /js/inventory.js based on the category.
                         Picking an item also auto-selects its category. -->
                    <select id="itemName" required>
                        <option value="">Select Item Name</option>
                    </select>

                    <!-- Shown only when Category = Other -->
                    <input type="text" id="itemNameOther" placeholder="Enter item name" style="display: none;">
                </div>


                <div class="form-row">

                    <div class="form-group">
                        <label for="itemQuantity">Quantity Left</label>
                        <input type="number" id="itemQuantity" min="0" placeholder="e.g. 20" required>
                        <small class="field-hint">Ilan ang meron ka ngayon.</small>
                    </div>

                    <div class="form-group">
                        <label for="minimumStock">Low Stock Alert</label>
                        <input type="number" id="minimumStock" min="0" placeholder="e.g. 5" required>
                        <small class="field-hint">Magiging "Low Stock" kapag ito o mas kaunti na ang natitira.</small>
                    </div>

                </div>


                <div class="modal-actions">
                    <button type="button" class="cancel-btn" id="cancelInventoryBtn">Cancel</button>
                    <button type="submit" class="save-btn">Save Inventory</button>
                </div>

            </form>

        </div>

    </div>


    <script src="/js/inventory.js"></script>
    <script src="/js/hamburger.js"></script>

</body>
</html>
