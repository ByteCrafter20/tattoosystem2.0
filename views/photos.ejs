<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Photos Gallery - Tattoo Home-Based Management System</title>

    <link rel="stylesheet" href="/css/photos.css">

    <style>
        .upload-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 28px;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .08);
        }

        .upload-card .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: flex-end;
        }

        .upload-card .form-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .upload-card input,
        .upload-card select {
            padding: 8px 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
        }

        .upload-card button {
            padding: 9px 18px;
            border: none;
            border-radius: 6px;
            background: #111;
            color: #fff;
            cursor: pointer;
        }

        .delete-btn {
            margin-top: 8px;
            padding: 6px 12px;
            border: none;
            border-radius: 6px;
            background: #c0392b;
            color: #fff;
            cursor: pointer;
        }

        .no-records {
            padding: 24px;
            text-align: center;
            opacity: .7;
        }
    </style>
</head>

<!-- Ang role ang nagsasabi kung admin ang bisita - dito nakabase ang upload/delete -->
<body data-role="<%= typeof role !== 'undefined' ? role : 'client' %>">

    <header class="navbar">

        <div class="logo">
            <img src="/images/TotatsSkinArtTattoo.jpg" alt="Totats Skin Art Tattoo Logo">
            Totats Skin Art Tattoo
        </div>

        <!-- HAMBURGER BUTTON (lumalabas lang sa mobile) -->
        <button class="hamburger" id="hamburger" type="button"
                aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <ul class="nav-links" id="navLinks">

            <% if ((typeof role !== 'undefined' ? role : 'client') === 'admin') { %>
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/clientappointment">Appointment of a Client</a></li>
                <li><a href="/inventory">Inventory</a></li>
                <li><a href="/reports">Reports &amp; Records</a></li>
            <% } else { %>
                <li><a href="/clientdashboard">Dashboard</a></li>
                <li><a href="/aboutus">About Us</a></li>
            <% } %>

            <li><a href="/photos" class="active">Photos Gallery</a></li>
            <li><a href="/logout">Logout</a></li>

        </ul>

    </header>


    <main class="container">

        <section class="page-header">

            <h1>Photos Gallery</h1>

            <p>
                Explore tattoos created by our artist and
                choose a design for your next tattoo.
            </p>

        </section>


        <!-- ==================================================
             ADMIN UPLOAD - itinatago para sa client ng photos.js
             ================================================== -->

        <section class="upload-card" id="uploadSection" style="display: none;">

            <h2>Upload Photo</h2>

            <p>Admin only. Add tattoo photos or designs the clients can choose from.</p>

            <form id="uploadForm">

                <div class="form-row">

                    <div class="form-group">
                        <label for="title">Title</label>
                        <input type="text" id="title" name="title" placeholder="Minimalist Tattoo" required>
                    </div>

                    <div class="form-group">
                        <label for="caption">Caption</label>
                        <input type="text" id="caption" name="caption" placeholder="Fine line tattoo design">
                    </div>

                    <div class="form-group">
                        <label for="category">Category</label>

                        <select id="category" name="category">
                            <option value="gallery">Client Tattoo Gallery</option>
                            <option value="design">Tattoo Design (choosable)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="image">Image</label>
                        <input type="file" id="image" name="image" accept="image/*" required>
                    </div>

                    <button type="submit">Upload</button>

                </div>

            </form>

        </section>


        <!-- ==================================================
             CLIENT TATTOO GALLERY
             ================================================== -->

        <section class="gallery-section">

            <div class="section-header">

                <div>
                    <h2>Client Tattoo Gallery</h2>

                    <p>
                        View tattoos previously created for our clients.
                    </p>
                </div>

            </div>

            <!-- Rendered from MongoDB by /js/photos.js -->
            <div class="gallery-grid" id="galleryGrid"></div>

            <div class="no-records" id="noGallery">
                No photos yet.
            </div>

        </section>


        <!-- ==================================================
             DESIGNS
             ================================================== -->

        <section class="gallery-section">

            <div class="section-header">

                <div>
                    <h2>Tattoo Designs to Choose From</h2>

                    <p>
                        Browse our available designs and find
                        inspiration for your appointment.
                    </p>
                </div>

            </div>

            <!-- Rendered from MongoDB by /js/photos.js -->
            <div class="gallery-grid" id="designGrid"></div>

            <div class="no-records" id="noDesigns">
                No designs yet.
            </div>

        </section>

    </main>


    <script src="/js/photo.js"></script>

    <!-- HAMBURGER TOGGLE -->
    <script>
        (function () {
            var hamburger = document.getElementById('hamburger');
            var navLinks = document.getElementById('navLinks');

            if (!hamburger || !navLinks) return;

            function setMenu(open) {
                hamburger.classList.toggle('open', open);
                navLinks.classList.toggle('open', open);
                hamburger.setAttribute('aria-expanded', open ? 'true' : 'false');
            }

            // Pindot sa hamburger / X
            hamburger.addEventListener('click', function (e) {
                e.stopPropagation();
                setMenu(!navLinks.classList.contains('open'));
            });

            // Isara kapag may pinindot na link
            navLinks.querySelectorAll('a').forEach(function (link) {
                link.addEventListener('click', function () { setMenu(false); });
            });

            // Isara kapag pinindot ang puting/madilim na area sa labas ng drawer
            navLinks.addEventListener('click', function (e) {
                if (e.target === navLinks) setMenu(false);
            });

            // Backup: kahit saan sa labas ng menu at ng hamburger
            document.addEventListener('click', function (e) {
                if (!navLinks.classList.contains('open')) return;
                if (navLinks.contains(e.target) || hamburger.contains(e.target)) return;
                setMenu(false);
            }, true);

            // Isara gamit ang Escape key
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') setMenu(false);
            });

            // Isara kapag lumapad na ang screen (desktop)
            window.addEventListener('resize', function () {
                if (window.innerWidth > 768) setMenu(false);
            });
        })();
    </script>

</body>
</html>