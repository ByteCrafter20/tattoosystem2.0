<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Totats Skin Art Tattoo | Tattoo Shop in San Jose del Monte, Bulacan</title>
  <meta name="description" content="Affordable quality tattoo in Sarmiento Townville, City of San Jose del Monte, Bulacan. Japanese, tribal, mechanical, anime and blackwork. Free aftercare ointment. Book online." />
  <link rel="stylesheet" href="/css/landingpage.css" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "TattooParlor",
    "name": "Totats Skin Art Tattoo",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Blk 8 Lot 4 James Street, Sarmiento Townville",
      "addressLocality": "City of San Jose del Monte",
      "addressRegion": "Bulacan",
      "addressCountry": "PH"
    }
  }
  </script>
</head>
<body>

  <header class="topbar">
    <a class="logo" href="/landingpage">
      <img src="/images/TotatsSkinArtTattoo.jpg" alt="Totats Skin Art Tattoo logo">
      <span class="brand">Totats <span>Skin Art Tattoo</span></span>
    </a>

    <nav class="top-links" aria-label="Main">
      <a class="link-item" href="#styles">Styles</a>
      <a class="link-item" href="#pricing">Pricing</a>
      <a class="link-item" href="#booking">Booking</a>
      <a class="link-item" href="#location">Location</a>
      <a class="link-item" href="/about" target="_blank" rel="noopener">About us</a>
      <a class="btn btn-primary" href="/login">Log in</a>
    </nav>
  </header>

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-inner">
        <p class="hero-place">Sarmiento Townville · San Jose del Monte, Bulacan</p>
        <h1>Affordable Quality <span>Tattoo</span></h1>
        <p class="lede">Clean work, fair prices and a free aftercare ointment with every tattoo. Book online in a few minutes.</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href="/register">Get started</a>
          <a class="btn btn-ghost btn-lg" href="#pricing">See prices</a>
        </div>
      </div>
    </section>

    <!-- HIGHLIGHTS -->
    <section class="highlights" aria-label="Highlights">
      <div class="highlight">
        <strong>Free aftercare</strong>
        <span>Ointment cream with every tattoo</span>
      </div>
      <div class="highlight">
        <strong>Price discount</strong>
        <span>Message us for a designed quote</span>
      </div>
      <div class="highlight">
        <strong>Book online</strong>
        <span>choose best designed, date and size</span>
      </div>
    </section>

    <!-- STYLES -->
    <section class="section" id="styles">
        <h2 class="section-title">Tattoo styles</h2>
        <p class="section-sub">Pick a style to see our work.</p>
    
        <div class="style-grid">
            <div class="style-card" style="--img:url('/images/japanese.jpg')">
                <span class="style-name">Japanese</span>
                <span class="style-desc">Bold color, dragons, waves and koi.</span>
            </div>
    
            <div class="style-card tribal-card" style="--img:url('/images/tribal.jpg')">
                <span class="style-name">Tribal</span>
                <span class="style-desc">Bold black patterns and sharp, flowing shapes.</span>
            </div>
    
            <div class="style-card" style="--img:url('/images/anime.jpg')">
                <span class="style-name">Anime</span>
                <span class="style-desc">Your favorite characters and scenes in ink.</span>
            </div>
    
            <div class="style-card" style="--img:url('/images/animeusopp.jpg')">
                <span class="style-name">Anime Usopp</span>
                <span class="style-desc">One Piece-inspired Usopp designs in ink.</span>
            </div>
    
            <div class="style-card" style="--img:url('/images/mechanical.jpg')">
                <span class="style-name">Mechanical</span>
                <span class="style-desc">Gears, pistons and biomechanical designs.</span>
            </div>
    
            <div class="style-card" style="--img:url('/images/blackwork.jpg')">
                <span class="style-name">Blackwork</span>
                <span class="style-desc">Solid black shapes and strong patterns.</span>
            </div>
        </div>
    
        <div class="view-more-wrap">
            <a class="view-more" href="/photopublic">View more</a>
        </div>
    </section>

    <!-- PRICING -->
    <section class="section section-alt" id="pricing">
      <h2 class="section-title">Tattoo prices</h2>
      <p class="section-sub">We price by the size of the piece, not by the hour. You see the total before you book.</p>

      <div class="price-grid">
        <article class="price-card">
          <h3>Small</h3>
          <p class="price">₱1,000</p>
          <p class="price-note">Minimalist designs are always priced as Small.</p>
        </article>

        <article class="price-card">
          <h3>Medium</h3>
          <p class="price">₱1,500</p>
          <p class="price-note">Good for forearms, calves and detailed pieces.</p>
        </article>

        <article class="price-card">
          <h3>Large</h3>
          <p class="price">₱10,000</p>
          <p class="price-note">Big pieces such as sleeves, backs and chests.</p>
        </article>

        <article class="price-card">
          <h3>Custom size</h3>
          <p class="price">₱700 <small>per inch</small></p>
          <p class="price-note">Enter your width and height in inches. Minimum ₱1,000.</p>
        </article>
      </div>

      <p class="price-foot">Pay in full or in part by Cash or GCash. The rest stays as your balance.</p>
    </section>

    <!-- HOW BOOKING WORKS -->
    <section class="section" id="booking">
      <h2 class="section-title">How booking works</h2>
      <p class="section-sub">Three steps from idea to appointment.</p>

      <div class="steps">
        <article class="step">
          <span class="step-no">1</span>
          <h3>Create an account</h3>
          <p>Register once with a username and password.</p>
        </article>
        <article class="step">
          <span class="step-no">2</span>
          <h3>Choose your tattoo</h3>
          <p>Pick the artist, date, size and placement, then upload a reference image.</p>
        </article>
        <article class="step">
          <span class="step-no">3</span>
          <h3>Pay and get confirmed</h3>
          <p>Pay by Cash or GCash. Track your status from your own dashboard.</p>
        </article>
      </div>
    </section>

    <!-- LOCATION -->
    <section class="section section-alt" id="location">
      <h2 class="section-title">Visit the shop</h2>
      <address class="address">
        Blk 8 Lot 4 James Street, Sarmiento Townville<br>
        City of San Jose del Monte, Bulacan
      </address>

      <div class="map-wrap">
        <iframe
          title="Totats Skin Art Tattoo location map"
          src="https://www.google.com/maps?q=Totats+Skin+Art+Tattoo,+San+Jose+del+Monte,+Bulacan&t=k&z=19&output=embed"
          width="100%"
          height="400"
          style="border:0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>

      <a class="btn btn-ghost" target="_blank" rel="noopener"
         href="https://www.google.com/maps/search/?api=1&query=Totats+Skin+Art+Tattoo+San+Jose+del+Monte+Bulacan">
        Open in Google Maps
      </a>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-grid">
      <div>
        <p class="foot-brand">Totats <span>Skin Art Tattoo</span></p>
        <p class="foot-text">Affordable quality tattoo in San Jose del Monte, Bulacan.</p>
      </div>
      <div>
        <p class="foot-head">Explore</p>
        <a href="#styles">Styles</a>
        <a href="#pricing">Pricing</a>
        <a href="#booking">Booking</a>
        <a href="#location">Location</a>
      </div>
      <div>
        <p class="foot-head">Account</p>
        <a href="/login">Log in</a>
        <a href="/register">Register</a>
        <a href="/about" target="_blank" rel="noopener">About us</a>
      </div>
      <div>
        <p class="foot-head">Address</p>
        <p class="foot-text">Blk 8 Lot 4 James Street<br>Sarmiento Townville<br>City of San Jose del Monte, Bulacan</p>
      </div>
    </div>
    <p class="foot-copy">© <%= new Date().getFullYear() %> Totats Skin Art Tattoo. All rights reserved.</p>
  </footer>

</body>
</html>