<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>

    <link rel="stylesheet" href="/css/login.css">

    <style>
        /* Error message na lalabas sa pagitan ng "Login" at ng Username field */
        .form-error {
            display: none;
            margin: 0 0 16px;
            padding: 10px 14px;
            border-radius: 6px;
            background: rgba(255, 77, 77, 0.12);
            border: 1px solid rgba(255, 77, 77, 0.45);
            color: #ff4d4d;
            font-size: 14px;
            text-align: center;
        }

        .form-error.show {
            display: block;
        }
    </style>
</head>
<body>

    <a href="/landingpage" class="back-arrow" aria-label="Back to landing page" title="Back to landing page">&#8592;</a>

    <div class="container">
        <div class="logo">
            <img src="/images/TotatsSkinArtTattoo.jpg" alt="Totats Skin Art Tattoo Logo">
            <h2>Login</h2>
        </div>

        <div id="loginError" class="form-error" role="alert" aria-live="polite"></div>

        <form id="loginForm">
            <div class="input-group">
                <label>Username</label>
                <input
                    type="text"
                    id="username"
                    name="username"
                    placeholder="Enter your username"
                    required>
            </div>

            <div class="input-group">
                <label>Password</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter your password"
                    required>
            </div>

            <button type="submit" id="loginButton">
                Login
            </button>
        </form>

        <p>
            Don't have an account?
            <a href="/register">Register Here</a>
        </p>

    </div>

    <script src="/js/login.js"></script>

</body>
</html>